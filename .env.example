# ─── SERVER ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── DATABASE ─────────────────────────────────────────────
DB_TYPE=sqlite
SQLITE_PATH=./sfdaass.db

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_EXPIRY=2h
JWT_REFRESH_EXPIRY=7d

# ─── MQTT BROKER ──────────────────────────────────────────
MQTT_HOST=your_hivemq_host_here
MQTT_PORT=8883
MQTT_USERNAME=your_username
MQTT_PASSWORD=your_password
MQTT_USE_TLS=true

# ─── TWILIO SMS ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_sid_here
TWILIO_AUTH_TOKEN=your_token_here
TWILIO_FROM_NUMBER=+1234567890
ALERT_PHONE_NUMBERS=+265000000000

# ─── EMAIL (Gmail / SMTP) ─────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=example@gmail.com
SMTP_PASS=your_app_password_here
ALERT_EMAILS=example@gmail.com

# ─── FIRE DETECTION THRESHOLDS ────────────────────────────
SMOKE_WARNING_PPM=250
SMOKE_CRITICAL_PPM=500
TEMP_WARNING_C=50
TEMP_CRITICAL_C=100
GAS_WARNING_PPM=150
GAS_CRITICAL_PPM=300
CONFIRM_DURATION_MS=5000

# ─── DEFAULT ADMIN ACCOUNT ─────────────────────────────
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
