# ─── SERVER ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── DATABASE ─────────────────────────────────────────────
# Use SQLite for development (no install needed)
DB_TYPE=sqlite
SQLITE_PATH=./sfdaass.db

# Use PostgreSQL for production (uncomment below)
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sfdaass
# DB_USER=postgres
# DB_PASS=yourpassword

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=sfdaass-secret
JWT_ACCESS_EXPIRY=2h
JWT_REFRESH_EXPIRY=7d

# ─── MQTT BROKER ──────────────────────────────────────────
