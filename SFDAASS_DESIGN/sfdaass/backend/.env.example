# ── Server ──────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── PostgreSQL ──────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sfdaass_db
DB_USER=postgres
DB_PASSWORD=1400

# ── JWT ─────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_64_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_also_change_this
JWT_REFRESH_EXPIRES_IN=30d

# ── MQTT Broker ─────────────────────────────────
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=sfdaass_server
MQTT_PASSWORD=mqtt_password

# ── Email (SMTP) ─────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=bsc-com-ne-06-22@unima.ac.mw
SMTP_PASS=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
ALERT_EMAIL_FROM=SFDAASS System <bsc-com-ne-06-22@unima.ac.mw>
ADMIN_EMAIL=bsc-com-ne-06-22@unima.ac.mw

# ── Twilio SMS ──────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
ALERT_PHONE_NUMBERS=+265999000001,+265999000002

# ── Geofence Defaults ────────────────────────────
DEFAULT_GEOFENCE_LAT=-13.9626
DEFAULT_GEOFENCE_LNG=33.7741
DEFAULT_GEOFENCE_RADIUS=500

# ── Sensor Thresholds ────────────────────────────
SMOKE_WARNING_THRESHOLD=300
SMOKE_CRITICAL_THRESHOLD=500
TEMP_WARNING_THRESHOLD=60
TEMP_CRITICAL_THRESHOLD=100
GAS_WARNING_THRESHOLD=400
GAS_CRITICAL_THRESHOLD=700
FIRE_CONFIRM_DURATION_MS=5000

# ── Rate Limiting ────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── CORS ─────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
